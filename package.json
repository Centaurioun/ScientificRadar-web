{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "clean": "next clean",
    "test:unit": "tsx --test lib/content/*.test.ts lib/design/*.test.ts lib/seo/*.test.ts lib/integrations/*.test.ts lib/config/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "test:responsive": "npm run build && playwright test"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@hookform/resolvers": "5.9.2",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isomorphic-dompurify": "4.7.0",
    "katex": "0.19.1",
    "lucide-react": "0.577.0",
    "motion": "12.43.0",
    "next": "16.4.5",
    "postcss": "^8.5.23",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^6.1.5",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}

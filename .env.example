# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# ScientificRadar Web — M1–M7 Environment Schema (Disabled / Fail-Closed Defaults)
# -----------------------------------------------------------------------------

# Runtime mode: "stage-a-demo" (default) or "stage-c-production"
SCIRAD_RUNTIME_MODE="stage-a-demo"

# Content repository adapter: "demo-fixtures" (default) or "published-snapshots"
SCIRAD_CONTENT_ADAPTER="demo-fixtures"

# Local Studio publishing integration (development/test only):
# SCIRAD_CONTENT_ADAPTER="published-snapshots"
# SCIENTIFICRADAR_STUDIO_PUBLISHING_URL="http://localhost:3000"
# Loopback HTTP media is allowed only for the exact configured localhost origin
# outside production; production requires a non-loopback HTTPS origin.

# Canonical site origin (must be a verified HTTPS domain before enabling production indexing)
NEXT_PUBLIC_SITE_URL="https://scientificradar.example"

# Explicit production indexing gate ("false" by default; keep false in demo/staging)
NEXT_PUBLIC_ENABLE_PRODUCTION_INDEXING="false"

# Optional Google Search Console verification meta token (disabled when empty)
NEXT_PUBLIC_GSC_VERIFICATION_TOKEN=""

# Optional Google Services & GA4 master gate ("false" by default)
NEXT_PUBLIC_ENABLE_GOOGLE_SERVICES="false"
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""

# Optional Google AdSense gate & publisher configuration ("false" by default)
NEXT_PUBLIC_ENABLE_ADSENSE="false"
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
NEXT_PUBLIC_ADS_TXT_RECORD=""

# Require explicit user consent before loading analytics or ad scripts ("true" by default)
NEXT_PUBLIC_REQUIRE_CONSENT="true"

# Server-only webhook secret for future Stage C cache revalidation (never prefix with NEXT_PUBLIC_)
SCIRAD_REVALIDATION_SECRET=""
